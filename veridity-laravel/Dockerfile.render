FROM php:8.3-apache

WORKDIR /var/www/html

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        unzip \
        curl \
        libpq-dev \
        libpng-dev \
        libzip-dev \
        nodejs \
        npm \
    && docker-php-ext-install pdo pdo_pgsql pgsql bcmath gd zip \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY . .

RUN composer install --no-dev --optimize-autoloader --ignore-platform-req=ext-oci8 \
    && npm install \
    && npm run build \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

COPY render-apache.conf /etc/apache2/sites-available/000-default.conf
COPY render-start.sh /usr/local/bin/render-start.sh
COPY php-upload.ini /usr/local/etc/php/conf.d/veridity-upload.ini

RUN a2enmod rewrite headers \
    && chmod +x /usr/local/bin/render-start.sh

EXPOSE 80

CMD ["render-start.sh"]
